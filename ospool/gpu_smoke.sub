# Run from the repository root:
#   mkdir -p logs
#   condor_submit ospool/gpu_smoke.sub

universe = container
container_image = osdf:///ospool/ap40/data/shahil.shaik/pytorch-2.9.0.sif

executable = ospool/run_gpu_smoke.sh

batch_name = lgma_gpu_smoke_$(Cluster)
log = logs/$(batch_name).log
output = logs/$(batch_name).$(Process).out
error = logs/$(batch_name).$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = src,experiments
transfer_output_files = results

request_cpus = 1
request_memory = 4GB
request_disk = 15GB
request_gpus = 1
gpus_minimum_capability = 7.5
gpus_minimum_memory = 4GB

+JobDurationCategory = "Medium"

# A failed smoke test should remain visible for diagnosis.
on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)

queue 1

