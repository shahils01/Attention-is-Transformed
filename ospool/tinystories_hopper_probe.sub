universe = container

container_image = osdf:///ospool/ap40/data/shahil.shaik/containers/pytorch-2.9.0-cuda12.6-v1.sif
executable = ospool/run_tinystories_hopper_probe.sh

batch_name = tinystories_hopper_probe_$(Cluster)
log    = logs/$(batch_name).log
output = logs/$(batch_name).$(Process).out
error  = logs/$(batch_name).$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

transfer_input_files = src, experiments, osdf:///ospool/ap40/data/shahil.shaik/datasets/tinystory-v1-20260720.tar.gz
transfer_output_files = hopper_probe_results

request_cpus   = 2
request_memory = 16GB
request_disk   = 20GB
request_gpus   = 1

# H100 and H200 are Hopper compute capability 9.0.
gpus_minimum_capability = 9.0
gpus_maximum_capability = 9.0
gpus_minimum_memory = 70000
gpus_minimum_runtime = 12.6

+JobDurationCategory = "Medium"

on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)

queue 1
