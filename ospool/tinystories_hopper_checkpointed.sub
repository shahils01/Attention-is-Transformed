# Submit from the repository root on ap40.
# This is a one-GPU, self-checkpointing H100/H200 job.

universe = container
container_image = osdf:///ospool/ap40/data/shahil.shaik/containers/pytorch-2.9.0-cuda12.6-v1.sif

executable = ospool/run_tinystories_hopper_checkpointed.sh

batch_name = tinystories_hopper_checkpointed_$(Cluster)
log = logs/$(batch_name).log
output = logs/$(batch_name).$(Process).out
error = logs/$(batch_name).$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = src, experiments, ospool, osdf:///ospool/ap40/data/shahil.shaik/datasets/tinystory-v1-20260720.tar.gz
transfer_output_files = ospool_training_results

# Exit code 85 asks HTCondor to save this directory and restart the job.
checkpoint_exit_code = 85
transfer_checkpoint_files = ospool_training_results

request_cpus = 4
request_memory = 32GB
request_disk = 40GB
request_gpus = 1

# H100 and H200 are Hopper GPUs with compute capability 9.0.
gpus_minimum_capability = 9.0
gpus_maximum_capability = 9.0
gpus_minimum_memory = 70000
gpus_minimum_runtime = 12.6

# Each execution segment is limited to four hours by the wrapper.
+JobDurationCategory = "Medium"

# The wrapper defaults to W&B disabled and four-hour execution segments.
# Enable W&B only after `python -c "import wandb"` succeeds inside the image.

on_exit_hold = (ExitBySignal == True) || ((ExitCode != 0) && (ExitCode != 85))

queue 1
