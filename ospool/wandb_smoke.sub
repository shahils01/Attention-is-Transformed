# CPU-only test of the W&B package, API key, and worker network connection.

universe = container
container_image = osdf:///ospool/ap40/data/shahil.shaik/containers/pytorch-2.9.0-cuda12.6-v1.sif

executable = ospool/run_wandb_smoke.sh

batch_name = wandb_smoke_$(Cluster)
log = logs/$(batch_name).log
output = logs/$(batch_name).$(Process).out
error = logs/$(batch_name).$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = ospool, osdf:///ospool/ap40/data/shahil.shaik/dependencies/wandb-py311.tar.gz
transfer_output_files = wandb_smoke_output

request_cpus = 1
request_memory = 2GB
request_disk = 8GB

+JobDurationCategory = "Medium"

on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)

queue 1
