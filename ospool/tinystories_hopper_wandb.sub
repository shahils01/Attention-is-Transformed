# W&B-enabled one-GPU A100/H100/H200/B100/B200 job.
# Create ospool/.wandb_api_key and the OSDF W&B bundle before submission.

universe = container
container_image = osdf:///ospool/ap40/data/shahil.shaik/containers/pytorch-2.9.0-cuda12.8-v1.sif

executable = ospool/run_tinystories_hopper_checkpointed.sh
arguments = online

batch_name = tinystories_a100_blackwell_wandb_$(Cluster)
log = logs/$(batch_name).log
output = logs/$(batch_name).$(Process).out
error = logs/$(batch_name).$(Process).err

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = src, experiments, ospool, osdf:///ospool/ap40/data/shahil.shaik/datasets/tinystory-v1-20260720.tar.gz, osdf:///ospool/ap40/data/shahil.shaik/dependencies/wandb-py311.tar.gz
transfer_output_files = ospool_training_results

checkpoint_exit_code = 85
transfer_checkpoint_files = ospool_training_results

request_cpus = 4
request_memory = 32GB
request_disk = 40GB
request_gpus = 1

# A100 is 8.0, Hopper is 9.0, and B100/B200 are 10.0.
gpus_minimum_capability = 8.0
gpus_maximum_capability = 10.0
gpus_minimum_memory = 70000
gpus_minimum_runtime = 12.8

+JobDurationCategory = "Medium"

on_exit_hold = (ExitBySignal == True) || ((ExitCode != 0) && (ExitCode != 85))

queue 1
